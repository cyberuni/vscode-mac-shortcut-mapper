{
	"$schema": "https://biomejs.dev/schemas/2.1.1/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/default-keybindings*.jsonc", "!skills-lock.json"]
	},
	"linter": {
		"rules": {
			"style": {
				// Ships at `info` in biome's recommended set, which exits 0 — a bare
				// `import ... from 'path'` would pass. Pinned so the check actually fails.
				"useNodejsImportProtocol": "error"
			},
			"suspicious": {
				"noConsole": { "level": "warn", "options": { "allow": ["log"] } }
			}
		}
	},
	"overrides": [
		{
			"includes": ["cursor-configs/**/*.json"],
			"json": {
				"parser": {
					"allowComments": true
				}
			}
		}
	]
}
